<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS Configuration for Angular SPA Deployment

  Purpose:
  - Enable Angular client-side routing on IIS servers
  - Redirect all non-file requests to index.html
  - Configure MIME types for static assets
  - Enable HTTPS redirection
  - Configure caching and compression

  Deployment Location:
  - This file should be in the dist/smo-portal folder after build
  - angular.json should include this file in assets to copy it during build

  IIS Requirements:
  - IIS 10+ recommended
  - URL Rewrite Module 2.0+ required (https://www.iis.net/downloads/microsoft/url-rewrite)
  - .NET Core Hosting Bundle (if serving API from same IIS instance)
-->
<configuration>
  <system.webServer>

    <!-- URL Rewrite Rules for Angular SPA Routing -->
    <rewrite>
      <rules>
        <!--
          Rule: Angular Client-Side Routing
          Redirects all requests to index.html UNLESS they match:
          - Physical files (js, css, images, fonts, etc.)
          - Physical directories
          - API endpoints (starts with /api)
        -->
        <rule name="Angular Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Don't rewrite if request is for a physical file -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <!-- Don't rewrite if request is for a physical directory -->
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <!-- Don't rewrite API calls -->
            <add input="{REQUEST_URI}" pattern="^/(api)" negate="true" />
          </conditions>
          <!-- Redirect to index.html with original URL preserved for Angular router -->
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Static Content MIME Types -->
    <!-- Ensures IIS serves modern web files with correct content types -->
    <staticContent>
      <!-- JSON Files -->
      <remove fileExtension=".json"/>
      <mimeMap fileExtension=".json" mimeType="application/json" />

      <!-- Web Fonts -->
      <remove fileExtension=".woff"/>
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <remove fileExtension=".woff2"/>
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />

      <!-- SVG Images -->
      <remove fileExtension=".svg"/>
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />

      <!-- Web Manifests -->
      <remove fileExtension=".webmanifest"/>
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <!-- HTTP Response Headers -->
    <httpProtocol>
      <customHeaders>
        <!-- Security Headers -->
        <!-- X-Content-Type-Options: Prevents MIME type sniffing -->
        <add name="X-Content-Type-Options" value="nosniff" />

        <!-- X-Frame-Options: Prevents clickjacking attacks -->
        <!-- SAMEORIGIN allows framing within same domain -->
        <add name="X-Frame-Options" value="SAMEORIGIN" />

        <!-- X-XSS-Protection: Enables browser XSS filter -->
        <add name="X-XSS-Protection" value="1; mode=block" />

        <!--
          Referrer-Policy: Controls referrer information sent with requests
          strict-origin-when-cross-origin: Full URL for same origin, origin only for HTTPS cross-origin
        -->
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />

        <!--
          Content-Security-Policy: Defines approved sources of content
          IMPORTANT: Adjust this based on your actual CDN/external resources
          Current policy allows:
          - 'self': Same origin
          - 'unsafe-inline': Inline scripts/styles (required for Angular)
          - 'unsafe-eval': eval() usage (required for some Angular features)
          - cdn.jsdelivr.net: Common CDN for libraries
          - fonts.googleapis.com: Google Fonts CSS
          - fonts.gstatic.com: Google Fonts files
        -->
        <add name="Content-Security-Policy"
             value="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://localhost:7001 https://api.smo.gov.sa;" />
      </customHeaders>
    </httpProtocol>

    <!-- HTTP Compression (Reduces bandwidth usage) -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- Static Content Caching -->
    <!-- Improves performance by caching static assets in browser -->
    <staticContent>
      <!-- Cache CSS and JavaScript files for 7 days -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <!-- Default Document -->
    <!-- Serve index.html by default when accessing root URL -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- HTTP Errors -->
    <!-- Custom error pages (optional - can be configured later) -->
    <httpErrors errorMode="Custom" defaultResponseMode="ExecuteURL">
      <!-- 404 Not Found: Redirect to Angular app (Angular router will handle) -->
      <remove statusCode="404" />
      <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />

      <!-- 500 Internal Server Error: Custom error page (can be created later) -->
      <!-- <remove statusCode="500" /> -->
      <!-- <error statusCode="500" path="/error.html" responseMode="ExecuteURL" /> -->
    </httpErrors>

  </system.webServer>
</configuration>
